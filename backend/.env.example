# ===============================
# ARCHIVO DE CONFIGURACIÓN EJEMPLO
# ===============================
# Copiar este archivo como .env y reemplazar los valores según sea necesario

# ===============================
# ENTORNO Y PUERTO
# ===============================
NODE_ENV=development
PORT=3001

# ===============================
# AUTENTICACIÓN JWT
# ===============================
JWT_SECRET=tu-clave-secreta-jwt-super-segura-aqui

# ===============================
# URL DEL FRONTEND
# ===============================
FRONTEND_URL=http://localhost:3000

# ===============================
# MONGODB - OPCIÓN 1: LOCAL
# ===============================
# Descomentar si usas MongoDB localmente
# MONGODB_URI=mongodb://localhost:27017/asisvox

# ===============================
# MONGODB - OPCIÓN 2: MONGODB ATLAS (CLOUD) ← RECOMENDADO PARA DESARROLLO
# ===============================
# 1. Ir a: https://www.mongodb.com/cloud/atlas
# 2. Crear cuenta gratuita
# 3. Crear clúster gratuito
# 4. Copiar connection string
# 5. Reemplazar usuario:contraseña con tus credenciales
# MONGODB_URI=mongodb+srv://usuario:contraseña@cluster-xxxxx.mongodb.net/asisvox?retryWrites=true&w=majority

# ===============================
# BASE DE DATOS - POSTGRESQL (OPCIONAL)
# ===============================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=asisvox_db
DB_USER=postgres
DB_PASSWORD=tu_contraseña_segura

# ===============================
# RECONOCIMIENTO DE VOZ
# ===============================
VOICE_RECOGNITION_ENABLED=true
VOICE_LANGUAGE=es-ES
VOICE_CONFIDENCE=80

# ===============================
# CONFIGURACIÓN ACADÉMICA
# ===============================
ACADEMIC_YEAR=2024
CURRENT_PERIOD=2024-1
GRADE_SCALE_MIN=0
GRADE_SCALE_MAX=20
PASSING_GRADE=12
ATTENDANCE_THRESHOLD=75

# ===============================
# LOGGING
# ===============================
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# ===============================
# CORS
# ===============================
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# ===============================
# RATE LIMITING
# ===============================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===============================
# SEGURIDAD
# ===============================
API_VERSION=1.0.0
SESSION_TIMEOUT=3600000

# ===============================
# NOTIFICACIONES (OPCIONAL)
# ===============================
# EMAIL_SERVICE=gmail
# EMAIL_USER=tu-email@gmail.com
# EMAIL_PASSWORD=tu-contraseña-aplicacion

# ===============================
# ALMACENAMIENTO (OPCIONAL)
# ===============================
# STORAGE_TYPE=local
# STORAGE_PATH=./uploads

