### ============= MASTER DATA TESTS =============

### Test 9: Get all subjects (master data)
GET {{baseUrl}}/master/subjects
Authorization: Bearer {{adminToken}}

### Test 10: Get all sections
GET {{baseUrl}}/master/sections
Authorization: Bearer {{adminToken}}

### Test 11: Get all academic years
GET {{baseUrl}}/master/academic-years
Authorization: Bearer {{adminToken}}

### Test 12: Get all grades
GET {{baseUrl}}/master/grades
Authorization: Bearer {{adminToken}}

### ============= CLASS TESTS =============

### Test 13: Create class (admin)
POST {{baseUrl}}/classes
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Matemáticas 1",
  "subject_id": 1,
  "section_id": 1,
  "academic_year_id": 1,
  "max_students": 30,
  "weeks_duration": 16,
  "teachers": [1]
}

### Test 14: Get all classes (admin)
GET {{baseUrl}}/classes
Authorization: Bearer {{adminToken}}

### Test 15: Get class by ID
GET {{baseUrl}}/classes/1
Authorization: Bearer {{adminToken}}

### ============= ATTENDANCE TESTS =============

### Test 16: Create attendance session
POST {{baseUrl}}/attendance/sessions
Authorization: Bearer {{teacherToken}}
Content-Type: application/json

{
  "class_id": 1,
  "session_date": "2025-11-29",
  "start_time": "09:00:00",
  "end_time": "10:00:00"
}

### Test 17: Get attendance sessions
GET {{baseUrl}}/attendance/sessions?class_id=1
Authorization: Bearer {{teacherToken}}

### Test 18: Record attendance
POST {{baseUrl}}/attendance/records
Authorization: Bearer {{teacherToken}}
Content-Type: application/json

{
  "session_id": 1,
  "student_id": 1,
  "status": "present"
}

### Test 19: Get attendance records
GET {{baseUrl}}/attendance/records?session_id=1
Authorization: Bearer {{teacherToken}}

### Test 20: Update attendance record
PUT {{baseUrl}}/attendance/records/1
Authorization: Bearer {{teacherToken}}
Content-Type: application/json

{
  "status": "late"
}

### ============= ASSESSMENT TESTS =============

### Test 21: Get assessment types
GET {{baseUrl}}/assessments/types
Authorization: Bearer {{teacherToken}}

### Test 22: Create assessment
POST {{baseUrl}}/assessments
Authorization: Bearer {{teacherToken}}
Content-Type: application/json

{
  "class_id": 1,
  "assessment_type_id": 1,
  "name": "Quiz 1",
  "description": "Quiz sobre fracciones",
  "total_points": 10,
  "scheduled_date": "2025-11-30"
}

### Test 23: Get assessments
GET {{baseUrl}}/assessments?class_id=1
Authorization: Bearer {{teacherToken}}

### Test 24: Get assessment by ID
GET {{baseUrl}}/assessments/1
Authorization: Bearer {{teacherToken}}

### Test 25: Update assessment
PUT {{baseUrl}}/assessments/1
Authorization: Bearer {{teacherToken}}
Content-Type: application/json

{
  "name": "Quiz 1 - Updated",
  "description": "Quiz sobre fracciones actualizado"
}

### ============= GRADING TESTS =============

### Test 26: Record single grade
POST {{baseUrl}}/grades
Authorization: Bearer {{teacherToken}}
Content-Type: application/json

{
  "assessment_id": 1,
  "student_id": 1,
  "score": 9.5,
  "comments": "Excelente desempeño"
}

### Test 27: Record grades in bulk
POST {{baseUrl}}/grades/bulk
Authorization: Bearer {{teacherToken}}
Content-Type: application/json

{
  "assessment_id": 1,
  "grades": [
    {"student_id": 1, "score": 9.5},
    {"student_id": 2, "score": 8.0},
    {"student_id": 3, "score": 7.5}
  ]
}

### Test 28: Get all grades
GET {{baseUrl}}/grades
Authorization: Bearer {{teacherToken}}

### Test 29: Get grade by ID
GET {{baseUrl}}/grades/1
Authorization: Bearer {{teacherToken}}

### Test 30: Get grade statistics
GET {{baseUrl}}/grades/statistics?assessment_id=1
Authorization: Bearer {{teacherToken}}

### Test 31: Update grade
PUT {{baseUrl}}/grades/1
Authorization: Bearer {{teacherToken}}
Content-Type: application/json

{
  "score": 9.8,
  "comments": "Corrección aplicada"
}

### Test 32: Delete grade
DELETE {{baseUrl}}/grades/1
Authorization: Bearer {{teacherToken}}

